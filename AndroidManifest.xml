<?xml version="1.0" encoding="utf-8"?>
<!-- Install identity is com.jackbhai.omnitools.native (a plain string for
     Android). Java classes live in com.jackbhai.omnitools.nativ because
     "native" is a Java keyword and cannot be a package segment; the build
     passes a custom-package flag so the generated R lands in the legal
     package. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jackbhai.omnitools.native">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.jackbhai.omnitools.nativ.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.jackbhai.omnitools.nativ.WatchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:supportsPictureInPicture="true" />

        <activity
            android:name="com.jackbhai.omnitools.nativ.WebFrameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name="com.jackbhai.omnitools.nativ.games.GameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Batch 3 Track A: native tools (launched from Menu via NativeTools) -->
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.RecorderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.ScannerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.FlashlightActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.CompassActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.LevelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.NoiseActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.QrActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="com.jackbhai.omnitools.nativ.tools.FilesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Batch 3 Track C: MilkDrop visualizations (projectM) -->
        <activity
            android:name="com.jackbhai.omnitools.nativ.viz.VizActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensor"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Batch 3 Track A: share fallback for API 26-28 (ShareUtil) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.jackbhai.omnitools.native.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.jackbhai.omnitools.nativ.widget.WidgetConfigActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.PlayerMiniWidgetProvider"
            android:exported="false"
            android:label="OmniTools Player (Mini)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jackbhai.omnitools.nativ.NOW_PLAYING_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_mini_info" />
        </receiver>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.PlayerBigWidgetProvider"
            android:exported="false"
            android:label="OmniTools Player (Big)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jackbhai.omnitools.nativ.NOW_PLAYING_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_big_info" />
        </receiver>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.VerseWidgetProvider"
            android:exported="false"
            android:label="OmniTools Verse of the Day">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_verse_info" />
        </receiver>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.QuickToolsWidgetProvider"
            android:exported="false"
            android:label="OmniTools Quick Tools">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_quicktools_info" />
        </receiver>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.SongsSearchWidgetProvider"
            android:exported="false"
            android:label="OmniTools Songs Search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_search_info" />
        </receiver>

        <receiver
            android:name="com.jackbhai.omnitools.nativ.widget.DownloadsWidgetProvider"
            android:exported="false"
            android:label="OmniTools Downloads">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_downloads_info" />
        </receiver>

        <service
            android:name="com.jackbhai.omnitools.nativ.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.session.MediaSession" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
